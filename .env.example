APP_ENV=development
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=toolbox
POSTGRES_DB=toolbox
DATABASE_URL=postgresql+asyncpg://toolbox:toolbox@localhost:5432/toolbox
SESSION_SECRET=dev-secret-change-me
# All origins that browser pages may call the API from. The nginx entry
# (http://localhost) must be included once you deploy with docker compose.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3100
