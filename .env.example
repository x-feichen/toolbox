APP_ENV=development
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=toolbox
POSTGRES_DB=toolbox
DATABASE_URL=postgresql+asyncpg://toolbox:toolbox@localhost:5432/toolbox
SESSION_SECRET=dev-secret-change-me
# Extra browser origins allowed to call the API. Same-origin requests (the
# normal docker compose setup, behind nginx) are always allowed, so this only
# matters for split deployments or local dev from another port.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3100
