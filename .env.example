APP_ENV=development
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=toolbox
POSTGRES_DB=toolbox
DATABASE_URL=postgresql+asyncpg://toolbox:toolbox@localhost:5432/toolbox
SESSION_SECRET=dev-secret-change-me
# Comma-separated emails that get the admin role at registration.
# Users already registered keep their current role.
ADMIN_EMAILS=ops@example.com
# Object storage (avatars) — MinIO credentials; change the password in production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=avatars
# 每日资讯：只读外部 Horizon PostgreSQL 的 daily_summaries 表。
# 留空则该功能禁用（其余功能不受影响）。
DAILY_NEWS_DATABASE_URL=postgresql://horizon:horizon@your-horizon-host:15433/horizon
DAILY_NEWS_LANGUAGE=zh
# Extra browser origins allowed to call the API. Same-origin requests (the
# normal docker compose setup, behind nginx) are always allowed, so this only
# matters for split deployments or local dev from another port.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3100
